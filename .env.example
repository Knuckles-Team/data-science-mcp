# ==============================================================================
# Data Science Mcp Environment Configuration
# ==============================================================================

# --- MCP Server Settings ---
HOST=0.0.0.0
PORT=8000
TRANSPORT=stdio # options: stdio, streamable-http, sse

# --- Telemetry & Observability (OTEL / Langfuse) ---
ENABLE_OTEL=True
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8080/api/public/otel
# OTEL_EXPORTER_OTLP_PUBLIC_KEY=pk-...
# OTEL_EXPORTER_OTLP_SECRET_KEY=sk-...
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# --- Enterprise Security & Access Governance (Eunomia) ---
EUNOMIA_TYPE=none # options: none, embedded, remote
EUNOMIA_POLICY_FILE=mcp_policies.json
# EUNOMIA_REMOTE_URL=http://eunomia-server:8000

# --- Core API / Client Credentials for Data-Science ---
DATA_SCIENCE_MCP_URL=http://localhost:8080
DATA_SCIENCE_MCP_TOKEN=your_token_here
# TLS verification for the upstream client. Set to a CA bundle path or False to disable.
# DATA_SCIENCE_MCP_SSL_VERIFY=
# Legacy alias for DATA_SCIENCE_MCP_SSL_VERIFY (truthy enables verification).
DATA_SCIENCE_MCP_VERIFY=True

# --- Inference Backend (out-of-process vLLM / SGLang for kernel-specialize, RL rollouts) ---
INFERENCE_BACKEND=vllm # options: vllm, sglang
# Base URL of the running inference server, e.g. http://host:30000
# INFERENCE_BASE_URL=
# Served model id exposed by the inference server.
# INFERENCE_MODEL=
# Bearer token for the inference server (default "EMPTY" for local servers).
# INFERENCE_API_KEY=EMPTY

# --- epistemic-graph engine (Rust compute for LSH/HNSW, near-pair search) ---
# Unix domain socket path to the epistemic-graph engine.
# EPISTEMIC_GRAPH_SOCKET=
# Alternate UDS env var honored by the engine client.
# GRAPH_SERVICE_SOCKET=
# TCP host:port for the epistemic-graph engine (takes precedence over the socket).
# EPISTEMIC_GRAPH_TCP=
# Cap on local O(n^2) near-pair fallback before requiring the Rust path (0 disables the cap).
DSM_NEAR_PAIRS_LOCAL_MAX=20000

# --- Tool Toggle Switches ---
MODEL_TRAININGTOOL=True
MODEL_EVOLUTIONTOOL=True
INTERPRETABILITYTOOL=True
DATA_MANAGEMENTTOOL=True
DATA_ENGINETOOL=True
QUANTTOOL=True
# Sub-surfaces of model-training; the code gates these via MODEL_TRAININGTOOL.
# TRAINERTOOL=True
# TRAINING_DATATOOL=True
# KERNEL_SPECIALIZETOOL=True
# DEEP_DELEGATETOOL=True
